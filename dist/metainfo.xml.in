<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPID@</id>
  <name>@NAME@</name>
  <summary>A native, feature-rich file manager for Linux</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>0BSD</project_license>

  <description>
    <p>
      Filebender is a native Linux file manager built with GTK4 and libadwaita.
      It aims to be feature-rich while feeling truly native to the Linux desktop.
    </p>
  </description>

  <launchable type="desktop-id">@APPID@.desktop</launchable>
  <provides>
    <binary>filebender</binary>
  </provides>

  <url type="homepage">https://github.com/KieranCanter/filebender</url>
  <url type="bugtracker">https://github.com/KieranCanter/filebender/issues</url>

  <developer id="dev.kicanter">
    <name>Kieran Canter</name>
  </developer>

  <content_rating type="oars-1.1" />

  <releases>
  </releases>
</component>
